# ═══════════════════════════════════════════════════════════════
#  Falcon-Pad — .gitignore
# ═══════════════════════════════════════════════════════════════

# ── Python ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pyc
*.egg-info/
*.egg
.eggs/
pip-wheel-metadata/
MANIFEST

# ── Environnements virtuels ───────────────────────────────────
.venv/
venv/
env/
.env
ENV/

# ── PyInstaller — sorties de build (le .spec est versionné) ──
build/
dist/
*.exe
*.exe.bak

# ── Runtime — dossiers générés au démarrage ───────────────────
logs/
config/
personal/
briefing/

# ── Tests — artefacts ─────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
coverage.xml
*.log

# ── Éditeurs / IDE ────────────────────────────────────────────
.vscode/
.idea/
.claude/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── OS ────────────────────────────────────────────────────────
desktop.ini
ehthumbs.db
